# ──────────────────────────────────────────────
# Content OS — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Model Provider ──────────────────────────
# Options: "openai", "openai-compatible"
MODEL_PROVIDER=openai

# OpenAI (when MODEL_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama / OpenAI-compatible (when MODEL_PROVIDER=openai-compatible)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama2
# OLLAMA_API_KEY=ollama

# ─── dev.to Publishing ──────────────────────
# Get your API key at: https://dev.to/settings/extensions
DEVTO_API_KEY=your_dev_to_api_key_here

# ─── dev.to MCP Server ──────────────────────
# The API talks to the dev.to MCP server over Streamable HTTP.
#
# With docker compose (recommended), the `devto-mcp` service runs
# `ghcr.io/arun2728/dev-to-mcp:latest` and is reachable at the default URL below.
#
# For local dev outside Docker, run the MCP image yourself:
#   docker run --rm -p 3005:3000 \
#     -e TRANSPORT=http \
#     -e DEVTO_API_KEY=$DEVTO_API_KEY \
#     ghcr.io/arun2728/dev-to-mcp:latest
# and set DEVTO_MCP_URL=http://localhost:3005/mcp
DEVTO_MCP_URL=http://devto-mcp:3000/mcp
