FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace root manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy package manifests for dependency resolution
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/

# Install all workspace deps
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/shared/ packages/shared/
COPY apps/api/ apps/api/

# Build shared package first, then API
RUN pnpm --filter @content-os/shared build && pnpm --filter @content-os/api build

EXPOSE 3001
ENV PORT=3001 NODE_ENV=production

# The dev.to MCP server runs as its own service (ghcr.io/arun2728/dev-to-mcp)
# and is reached over HTTP. Configure via DEVTO_MCP_URL (default set in docker-compose).
ENV DEVTO_MCP_URL=http://devto-mcp:3000/mcp

CMD ["node", "apps/api/dist/index.js"]
