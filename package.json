{
  "name": "content-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "clean": "pnpm -r --parallel exec rm -rf dist .next build out",
    "dev": "pnpm clean && pnpm -F @content-os/shared build && pnpm --parallel -F './apps/**' dev",
    "dev:web": "pnpm --filter @content-os/web dev",
    "dev:api": "pnpm --filter @content-os/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @content-os/web build",
    "build:api": "pnpm --filter @content-os/api build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
